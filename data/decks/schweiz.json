{
  "formatVersion": 2,
  "name": "Fische der Schweiz",
  "description": "Einheimische und eingebürgerte Süßwasserfische der Schweiz, dazu die Neunaugen. Level 1 (Einsteiger) enthält markante, leicht unterscheidbare Arten, Level 2 (Fortgeschritten) häufige Arten mit ähnlichem Körperbau, Level 3 (Experten) seltene, endemische oder schwer unterscheidbare Arten wie die Felchen.",
  "translations": {
    "de": {
      "name": "Fische der Schweiz",
      "description": "Einheimische und eingebürgerte Süßwasserfische der Schweiz, dazu die Neunaugen. Level 1 (Einsteiger) enthält markante, leicht unterscheidbare Arten, Level 2 (Fortgeschritten) häufige Arten mit ähnlichem Körperbau, Level 3 (Experten) seltene, endemische oder schwer unterscheidbare Arten wie die Felchen."
    },
    "en": {
      "name": "Fish of Switzerland",
      "description": "Native and introduced freshwater fish of Switzerland, plus the lampreys. Level 1 (beginner) holds distinctive species that are easy to tell apart, Level 2 (intermediate) common species with similar body shapes, Level 3 (expert) rare, endemic or hard-to-distinguish species such as the whitefish."
    },
    "fr": {
      "name": "Poissons de Suisse",
      "description": "Poissons d'eau douce indigènes et introduits de Suisse, ainsi que les lamproies. Le niveau 1 (débutant) réunit des espèces caractéristiques et faciles à distinguer, le niveau 2 (avancé) des espèces communes à la morphologie semblable, le niveau 3 (expert) des espèces rares, endémiques ou difficiles à distinguer comme les corégones."
    },
    "es": {
      "name": "Peces de Suiza",
      "description": "Peces de agua dulce autóctonos e introducidos de Suiza, además de las lampreas. El nivel 1 (principiante) reúne especies llamativas y fáciles de distinguir, el nivel 2 (avanzado) especies comunes de morfología parecida y el nivel 3 (experto) especies raras, endémicas o difíciles de distinguir, como los coregonos."
    }
  },
