{
  "formatVersion": 2,
  "name": "Great Barrier Reef & Korallenmeer",
  "description": "Rifffische, Haie, Rochen, Meeresschildkröten und Kopffüßer des Great Barrier Reef, Neukaledoniens und Vanuatus. Level 1 enthält die häufigsten Arten und Highlights wie Napoleon, Riffmanta und Dugong, Level 2 und 3 weitere Arten nach Häufigkeit.",
  "translations": {
    "de": {
      "name": "Great Barrier Reef & Korallenmeer",
      "description": "Rifffische, Haie, Rochen, Meeresschildkröten und Kopffüßer des Great Barrier Reef, Neukaledoniens und Vanuatus. Level 1 enthält die häufigsten Arten und Highlights wie Napoleon, Riffmanta und Dugong, Level 2 und 3 weitere Arten nach Häufigkeit."
    },
    "en": {
      "name": "Great Barrier Reef & Coral Sea",
      "description": "Reef fish, sharks, rays, sea turtles and cephalopods of the Great Barrier Reef, New Caledonia and Vanuatu. Level 1 holds the most common species and highlights such as the humphead wrasse, reef manta and dugong, Levels 2 and 3 further species by frequency."
    },
    "fr": {
      "name": "Grande Barrière de corail et mer de Corail",
      "description": "Poissons de récif, requins, raies, tortues marines et céphalopodes de la Grande Barrière de corail, de la Nouvelle-Calédonie et du Vanuatu. Le niveau 1 réunit les espèces les plus communes et des incontournables comme le napoléon, la raie manta de récif et le dugong, les niveaux 2 et 3 d'autres espèces par fréquence."
    },
    "es": {
      "name": "Gran Barrera de Coral y mar del Coral",
      "description": "Peces de arrecife, tiburones, rayas, tortugas marinas y cefalópodos de la Gran Barrera de Coral, Nueva Caledonia y Vanuatu. El nivel 1 reúne las especies más comunes y joyas como el pez napoleón, la manta de arrecife y el dugongo, los niveles 2 y 3 otras especies por frecuencia."
    }
  },
